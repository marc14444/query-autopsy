{
  "name": "@query-autopsy/core",
  "version": "1.8.3",
  "description": "Zero-dependency PostgreSQL, MySQL 8+, and SQLite EXPLAIN plan parser, diagnostic engine, SQL safety classifier, and PII redactor.",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc14444/query-autopsy.git",
    "directory": "packages/core"
  },
  "keywords": [
    "postgresql",
    "mysql",
    "sqlite",
    "explain",
    "sql",
    "performance",
    "query-analyzer"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json"
  },
  "dependencies": {}
}
