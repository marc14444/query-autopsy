{
  "name": "query-autopsy",
  "displayName": "QueryAutopsy",
  "description": "X-Ray your PostgreSQL, MySQL, and SQLite queries inside VS Code. Inspect EXPLAIN execution plans, catch Full Table Scans, buffer bottlenecks, and row misestimates.",
  "version": "1.1.0",
  "publisher": "marc14444",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "homepage": "https://github.com/marc14444/query-autopsy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marc14444/query-autopsy.git"
  },
  "bugs": {
    "url": "https://github.com/marc14444/query-autopsy/issues"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "mysql",
    "sqlite",
    "sql",
    "explain",
    "performance",
    "query-analyzer",
    "database",
    "prisma"
  ],
  "categories": [
    "Other",
    "Debuggers",
    "Linters"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces, .env/docker-compose auto-discovery, database queries, and index creation are disabled to protect against untrusted workspace configurations."
    }
  },
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:postgres",
    "onLanguage:pgsql",
    "onLanguage:mysql",
    "onLanguage:sqlite",
    "onLanguage:mssql",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onView:queryAutopsy.slowQueries"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "queryAutopsy.inspectSelection",
        "title": "Inspect Query Performance (EXPLAIN ANALYZE)",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.inspectSelectionEstimate",
        "title": "Inspect Query Plan Only (EXPLAIN without execution)",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.configureConnection",
        "title": "Switch / Configure Database Profile",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.discoverConnections",
        "title": "Auto-Detect Local Databases (.env / Docker / SQLite)",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.clearConnection",
        "title": "Clear Stored Database Connections",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.inspectCodeLens",
        "title": "Inspect CodeLens SQL Block",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.copySuggestedIndex",
        "title": "Copy Suggested Index SQL",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.applySuggestedIndex",
        "title": "Create Suggested Index & Re-analyze",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.refreshSlowQueries",
        "title": "Refresh Slow Queries",
        "category": "QueryAutopsy",
        "icon": "$(refresh)"
      },
      {
        "command": "queryAutopsy.toggleSlowQuerySort",
        "title": "Toggle Slow Query Sort (Mean / Total Time)",
        "category": "QueryAutopsy",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "queryAutopsy.inspectSlowQuery",
        "title": "Inspect Slow Query (ANALYZE)",
        "category": "QueryAutopsy"
      },
      {
        "command": "queryAutopsy.estimateSlowQuery",
        "title": "Estimate Slow Query Plan",
        "category": "QueryAutopsy",
        "icon": "$(eye)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "queryAutopsy.slowQueries",
          "name": "QueryAutopsy: Slow Queries"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "queryAutopsy.inspectCodeLens",
          "when": "false"
        },
        {
          "command": "queryAutopsy.copySuggestedIndex",
          "when": "false"
        },
        {
          "command": "queryAutopsy.applySuggestedIndex",
          "when": "false"
        },
        {
          "command": "queryAutopsy.inspectSlowQuery",
          "when": "false"
        },
        {
          "command": "queryAutopsy.estimateSlowQuery",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "queryAutopsy.refreshSlowQueries",
          "when": "view == queryAutopsy.slowQueries",
          "group": "navigation@1"
        },
        {
          "command": "queryAutopsy.toggleSlowQuerySort",
          "when": "view == queryAutopsy.slowQueries",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "queryAutopsy.estimateSlowQuery",
          "when": "view == queryAutopsy.slowQueries && viewItem == slowQueryEntry",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "queryAutopsy.inspectSelection",
          "when": "editorHasSelection || editorLangId == sql || editorLangId == postgres || editorLangId == pgsql || editorLangId == mysql || editorLangId == sqlite || resourceExtname == .sql",
          "group": "navigation@100"
        },
        {
          "command": "queryAutopsy.inspectSelectionEstimate",
          "when": "editorHasSelection || editorLangId == sql || editorLangId == postgres || editorLangId == pgsql || editorLangId == mysql || editorLangId == sqlite || resourceExtname == .sql",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "QueryAutopsy",
      "properties": {
        "queryAutopsy.postgres.statementTimeoutMs": {
          "type": "integer",
          "default": 5000,
          "minimum": 100,
          "maximum": 120000,
          "description": "Maximum execution time (in ms) for EXPLAIN ANALYZE queries via SET LOCAL statement_timeout."
        },
        "queryAutopsy.postgres.allowWriteAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Allow EXPLAIN ANALYZE on INSERT/UPDATE/DELETE statements inside an isolated transaction that always issues ROLLBACK. Keep false for maximum safety."
        },
        "queryAutopsy.postgres.fallbackConnectionString": {
          "type": "string",
          "default": "",
          "description": "Optional non-sensitive local development connection URI (e.g. postgresql://postgres@localhost:5432/query_autopsy_dev). Prefer 'QueryAutopsy: Configure PostgreSQL Connection' which stores credentials in VS Code SecretStorage."
        },
        "queryAutopsy.diagnostics.seqScanRowThreshold": {
          "type": "integer",
          "default": 1000,
          "minimum": 10,
          "description": "Minimum scanned rows on a Seq Scan node before raising a diagnostic warning."
        },
        "queryAutopsy.output.showRawJson": {
          "type": "boolean",
          "default": false,
          "description": "Include the raw PostgreSQL EXPLAIN JSON payload in the QueryAutopsy Output Channel."
        },
        "queryAutopsy.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline CodeLens actions ('Inspect Plan' / 'Estimate Plan') above SQL queries in .sql and TypeScript/JavaScript files."
        },
        "queryAutopsy.privacy.redactLiteralsInReports": {
          "type": "boolean",
          "default": false,
          "description": "Redact SQL string literals as '[REDACTED]' in Inspection Reports (Webview, Output Channel, and copied Markdown PR reports) before sharing with AI tools or teammates."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "node esbuild.config.mjs --production",
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package --no-dependencies",
    "check-types": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check-types && npm run test && npm run package"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.13.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/sql.js": "^1.16.0",
    "@types/vscode": "^1.93.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
